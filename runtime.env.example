# Copy to runtime.env, chmod 600, then edit privately. Never commit real values.
NB_SETUP_KEY=
# NB_MANAGEMENT_URL=https://your-netbird-management.example
# Accept only after personally reviewing the XTTS model terms:
# COQUI_TOS_AGREED=1
VOSK_DEFAULT_LANGUAGE=de
# Flag-gated speech provisioning, mirroring LLAMA_DOWNLOAD_MODELS: both run once
# at container startup/first TTS use. Review the model licenses first:
# - Vosk (Apache-2.0, alphacephei): large models de-0.21 (~2.9 GB), fr-0.22,
#   ja-0.22 (~1.6 GB) land in /workspace/vosk/<lang>; small versions stay backed up.
VOSK_DOWNLOAD_MODELS=1
# - Qwen3-TTS 12Hz 1.7B Base (Apache-2.0, pinned revision fd4b254): ~4.3 GB at
#   /workspace/qwen3-tts/1.7B-Base, provisioned by the worker before first use.
PRAXIS_QWEN_TTS_DOWNLOAD=1
PRAXIS_QWEN_TTS_MODEL_DIR=/workspace/qwen3-tts/1.7B-Base
PRAXIS_QWEN_TTS_IDLE_SECONDS=600

# Codacus perf: Qwen3.8-Flash-Next 177B UD-IQ3_XXS (NOT the old 27B model).
# These opt-ins run at container startup. Review the Qwen Community license
# linked in scripts/llama-models.json BEFORE enabling model downloads.
# Downloads the three main shards (~82 GB) plus the matching shared Q8 MTP head
# (~2.8 GB); verifies pinned SHA256s and reuses cached files.
LLAMA_DOWNLOAD_MODELS=1
LLAMA_MODEL_DIR=/workspace/llama.cpp/models/qwen3.8-flash-next/UD-IQ3_XXS
LLAMA_MTP_MODEL_DIR=/workspace/llama.cpp/models/qwen3.8-flash-next/MTP
LLAMA_DOWNLOAD_TIMEOUT_SECONDS=21600
# Run two generic code/chat routing traces once, up to 512 tokens each, then merge.
# This performs GPU inference at first startup. Existing verified profiles are reused.
LLAMA_GENERATE_PROFILE=1
LLAMA_MOE_CACHE_PROFILE=/workspace/llama.cpp/profiles/qwen3.8-flash-next-merged.csv
LLAMA_TRACE_TIMEOUT_SECONDS=3600
# Flash row from Codacus: 56 slots (NOT the generic example's 112), draft-mtp.
# Always uses draft-mtp with the separately pinned matching head (not another LLM).
# Shared Q8 MTP is GPU-offloaded with at most two draft tokens per step.
LLAMA_MOE_CACHE_SLOTS=56
# One worker per available physical core, not per SMT/logical CPU.
# Respects process affinity/cpuset and visible CPU quotas; unset also means auto.
# Applies to generation, prompt processing, MTP, routing traces and embeddings.
LLAMA_THREADS=auto
# Optional manual override (bypasses auto detection): LLAMA_THREADS=6
# Conservative context/prefill defaults; not a claimed exact video benchmark.
# Larger context competes with expert cache, MTP and the unchanged speech stack.
# Per-instance tuning may override these values in /workspace/llama.cpp/runtime-settings.json
# (e.g. {"LLAMA_CONTEXT_SIZE":32768}); restart only the chat service after measuring VRAM.
LLAMA_CONTEXT_SIZE=4096
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
# Host pinning stays enabled; 0 removes the presence-based flag in the child.
GGML_CUDA_REGISTER_HOST=1
# Experimental expert prefetch caused non-finite inference in multi-request GPU
# tests. It is fenced off even if an older template still supplies 1 (with warning).
# MTP, the expert cache, CUDA graphs and async CPU splits remain enabled.
GGML_SCHED_PREFETCH_EXPERTS=0
# Qwen3-TTS synthesis speed on RTX 3090: torch.compile roughly halves the per-
# token decode time (123 ms/step -> 65 ms). The first worker start pays a one-time
# ~50-100 s compile; PRAXIS_QWEN_TTS_COMPILE=0 disables it. Attention stays on
# measured-fastest sdpa; flash_attention_2 is available via PRAXIS_QWEN_TTS_ATTN.
PRAXIS_QWEN_TTS_COMPILE=1
# PRAXIS_QWEN_TTS_ATTN=flash_attention_2
# Keep Nomic embeddings through a second llama-server, on CPU, same private API.
LLAMA_EMBEDDING_ENABLED=1
LLAMA_EMBEDDING_MODEL_DIR=/workspace/llama.cpp/models/nomic-embed-text
# Do not carry OLLAMA_* or LLAMA_ARG_* settings over from the other stack.
